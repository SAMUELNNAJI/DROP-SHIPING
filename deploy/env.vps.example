# DropHub — production environment for a VPS (Ubuntu + Nginx + Gunicorn).
#
# Copy to the project root as `.env` (git-ignored) and replace every CHANGE-ME:
#   cd /opt/drophub && cp deploy/env.vps.example .env && nano .env
#
# Django reads this file itself; real environment variables still win.

# ── Core ────────────────────────────────────────────────────────────────────
# The VPS must never run with DEBUG=True (it would leak errors and disable
# all the security settings at the bottom of settings.py).
DEBUG=false

# Required. Generate a strong value with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=CHANGE-ME-generate-a-long-random-string

# ── Database ────────────────────────────────────────────────────────────────
# Option A (used in DEPLOY_VPS.md): Postgres running on this same VPS.
DATABASE_URL=postgresql://drophub:CHANGE-ME-DB-PASSWORD@localhost:5432/drophub
# Option B: keep your existing Neon database — paste its pooled URL instead:
# DATABASE_URL=postgresql://…neon.tech/neondb?sslmode=require&channel_binding=require
# Long-lived connections are safe with a local Postgres (unlike Neon's
# transaction-pooler endpoint, which wants DB_CONN_MAX_AGE=0):
DB_CONN_MAX_AGE=60

# ── Domain ──────────────────────────────────────────────────────────────────
# The hostname(s) Nginx serves for this app.
DJANGO_ALLOWED_HOSTS=drophub.example.com,www.drophub.example.com
# Required for form POSTs over HTTPS (sign in, checkout, admin…).
DJANGO_CSRF_TRUSTED_ORIGINS=https://drophub.example.com,https://www.drophub.example.com

# ── TLS ─────────────────────────────────────────────────────────────────────
# Keep False for the first boot, run certbot (DEPLOY_VPS.md step 8), confirm
# HTTPS works, then change to True and restart the service.
SECURE_SSL_REDIRECT=False
# Optional, once the domain is final (browsers remember HSTS for a year!):
# SECURE_HSTS_SECONDS=31536000

# ── Admin account ───────────────────────────────────────────────────────────
# build.sh / deploy.sh create or repair this account on every run.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=use-a-long-unique-password

# ── Uploads ─────────────────────────────────────────────────────────────────
# Media defaults to /opt/drophub/media and Nginx serves it at /media/.
# MEDIA_ROOT=/opt/drophub/media

# ── Payments, email, OAuth ──────────────────────────────────────────────────
# Exactly the same variables as on Render (PAYSTACK_PUBLIC_KEY /
# PAYSTACK_SECRET_KEY, PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET, PI_API_KEY,
# EMAIL_HOST…). Copy the values out of the Render dashboard before you switch
# traffic, and point each provider's webhook/callback at your new domain
# (https://…) once the site is live.

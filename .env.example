# Local development environment variables.
#
# Copy this file to `.env` (which is git-ignored) and adjust as needed.
# In production these are set in the Render dashboard's Environment tab.
# Any variable already present in the real environment wins over `.env`.

# Debug mode. Defaults to False whenever Render runs the app (RENDER=true),
# and to True on a development machine.
DEBUG=True

# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# SECRET_KEY=

# Postgres / Neon connection string. Comment it out locally to keep using the
# bundled SQLite database.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
# DB_CONN_MAX_AGE=0

# Comma-separated hostnames Django is allowed to serve. Render's own hostname is
# added automatically; add custom domains here.
# DJANGO_ALLOWED_HOSTS=www.example.com,example.com

# Comma-separated HTTPS origins allowed to submit forms (needed for custom
# domains; https://*.onrender.com is allowed automatically).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com

# Optional deployment administrator. Set all three only in Render's Environment
# tab; build.sh creates or updates this account after migrations.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=use-a-long-unique-password

# Where uploaded media is stored. Point this at a Render persistent disk
# (e.g. /var/data/media) to keep uploads across deploys.
# MEDIA_ROOT=

# Set to False to stop Django from serving /media/ itself.
# SERVE_MEDIA=True

# Optional SMTP email. Without EMAIL_HOST, email is written to the logs.
# Note: Render's free tier blocks outbound SMTP on ports 25/465/587.
# DJANGO_EMAIL_BACKEND=
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=secret
# EMAIL_USE_TLS=True

# Optional OAuth credentials for Google / Apple sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Payments: add these only in your hosting provider's protected environment.
# Paystack public key goes to the browser, secret key stays server-side.
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_SECRET_KEY=sk_test_...
# PayPal client ID and secret for the JS SDK + server-side create/capture.
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# Pi Network — payments run through Pi's own gateway inside the Pi Browser.
# API key from the Pi Developer Portal; the server uses it to approve and
# complete each payment, and to verify the money before an order is created.
# PI_API_KEY=
# The app's receiving wallet. Must match the wallet registered on the app in
# the Pi Developer Portal — every payment is checked against it before it is
# completed.
# PI_WALLET_ADDRESS=GDLBJSWOJ36AEVXRQCGRGEEA65MVTLWLZ2GIVHWVFENOLMT4XQLVOPEV
# Keep this on (the default). Pi then works like Paystack/PayPal: the buyer is
# handed to Pi's payment sheet and the order is created automatically. Buyers
# outside the Pi Browser are never charged and are told to reopen the checkout
# in Pi Browser. Set to False only if you deliberately want the old
# manual-transfer flow (see PI_MANUAL_TRANSFER below).
# PI_REQUIRE_BROWSER=True
# Legacy: manual Pi transfer with admin reconciliation. Ignored while
# PI_REQUIRE_BROWSER is on, and off by default.
# PI_MANUAL_TRANSFER=False
# Use the Pi Developer Portal sandbox app (test Pi) rather than mainnet.
# PI_SANDBOX=False

# Optional: enable HSTS (seconds) once your production domain is stable.
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=True
